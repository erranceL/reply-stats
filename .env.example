# ===== 必填 =====

# Slack 应用后台 Basic Information → App Credentials 里的三项
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# 本服务对外的 HTTPS 地址（不带结尾斜杠），要和 manifest.yml 里的域名一致
PUBLIC_URL=https://reply-stats.tfoffices.com

# 用来加密存库的 Slack token。生成方式：openssl rand -hex 32
# 丢失或更换后，已保存的 token 无法解密，需要重新安装和授权
TOKEN_ENCRYPTION_KEY=

# ===== 可选（下面写的都是默认值） =====

# 生产环境与 ema-mgt（3000）错开，用 3100；本机开发可改回 3000
PORT=3100
DB_PATH=./data/reply-stats.db

# 只允许这个工作区安装和授权（工作区 ID，T 开头）。建议填上；留空则不限制
SLACK_TEAM_ID=

# 超过多少分钟未回复算超时
THRESHOLD_MINUTES=30

# “好的”“收到”“谢谢”“我下午看一下”“已处理”“OK”这类收尾语和纯表情不会让对方开始计时
# （内置词库见 src/closing.js）。这里可以追加你们团队常用的说法，逗号分隔，如：阔以,莫得问题
CLOSING_PHRASES=

# 是否只计算工作时间。设为 false 则按实际经过的时间算（含夜间和周末）
WORK_HOURS_ONLY=true
TIMEZONE=Asia/Shanghai
# 可多段（午休不计时）。也可用旧写法 WORK_START + WORK_END 表示单段
WORK_HOURS=10:30-12:00,14:00-17:30
# 工作日：1=周一 … 7=周日
WORK_DAYS=1,2,3,4,5
# 法定节假日（不算工作日）和调休补班日（算工作日），格式 YYYY-MM-DD，逗号分隔
HOLIDAYS=
EXTRA_WORKDAYS=

# 除工作区管理员/所有者外，还允许哪些成员查看全员数据（成员 ID，逗号分隔，如 U012ABC,U034DEF）
ADMIN_USERS=

# 不纳入回复速率统计的账号（被 @ / 被私聊都不计；报表也会跳过）
# 按邮箱排除需要 users:read.email；更稳妥是直接写成员 ID
EXCLUDE_EMAILS=tony@tf.xyz,wangdana@tf.xyz
# tony he / wangdana(Wyatt wong)
EXCLUDE_USERS=U0AHDBSNZU4,U0AJ421SKQQ

# 周报发到哪个频道（频道 ID，如 C0123456789，不是频道名）。留空则不发周报。
# 频道里的所有人都能看到全员排行，请用只有管理者的私有频道，并先在频道里 /invite @reply-stats 邀请机器人
REPORT_CHANNEL=
# 每周几、几点发周报，内容是此前完整的 7 天
REPORT_WEEKDAY=1
REPORT_TIME=09:30

# 设为 true 时机器人会自动加入所有公开频道（每个频道都会出现一条“已加入”提示）。
# 默认 false：只统计你手动邀请了机器人的频道
AUTO_JOIN_PUBLIC_CHANNELS=false

# 斜杠命令名，改了要同步修改 manifest.yml
SLASH_COMMAND=/reply-stats
